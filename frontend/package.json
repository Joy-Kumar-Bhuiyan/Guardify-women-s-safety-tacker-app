{
  "name": "@guardify/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,vue,json}\"",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.8",
    "leaflet": "1.9.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
