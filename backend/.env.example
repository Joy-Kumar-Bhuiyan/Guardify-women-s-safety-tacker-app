NODE_ENV=development
PORT=5000
TRUST_PROXY=1
APP_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Generate at least 32 random bytes and encode as base64 or use a 64+ character value.
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Format: activeKeyId:base64-encoded-32-byte-key. Multiple keys are comma-separated for rotation.
DATA_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY
DATA_ACTIVE_KEY_ID=v1
LOCATION_RETENTION_DAYS=30
SHARE_DEFAULT_TTL_MINUTES=120
FIREBASE_PROJECT_ID=replace-me
# Prefer application-default credentials/workload identity. If unavoidable, store JSON only in the platform secret store.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_DATABASE_URL=
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional: absolute path to a built frontend. The combined Docker image sets this automatically.
STATIC_DIR=
